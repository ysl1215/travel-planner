{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["destination", "totalDays", "overview", "days"],
  "properties": {
    "destination": { "type": "string" },
    "totalDays": { "type": "integer", "minimum": 1 },
    "overview": { "type": "string" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "location"],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "location": { "type": "string" },
          "theme": { "type": "string" },
          "morning": { "type": "array", "items": { "type": "object" } },
          "afternoon": { "type": "array", "items": { "type": "object" } },
          "evening": { "type": "array", "items": { "type": "object" } },
          "travelNote": { "type": "string" },
          "accommodation": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "topAttractions": { "type": "array", "items": { "type": "object" } },
    "foodRecommendations": { "type": "array", "items": { "type": "object" } },
    "route": { "type": "array", "items": { "type": "object" } },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster", "attractions", "options", "recommendation", "recommendation_reason"],
        "properties": {
          "cluster": { "type": "string" },
          "attractions": { "type": "array", "items": { "type": "string" } },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "attractions", "hours", "tradeoff"],
              "properties": {
                "label":       { "type": "string" },
                "attractions": { "type": "array", "items": { "type": "string" } },
                "hours":       { "type": "number" },
                "tradeoff":    { "type": "string" }
              }
            }
          },
          "recommendation":        { "type": "string" },
          "recommendation_reason": { "type": "string" }
        }
      }
    },
    "practicalTips": { "type": "array", "items": { "type": "string" } },
    "bestTimeToVisit": { "type": "string" }
  },
  "additionalProperties": true
}