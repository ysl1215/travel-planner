# ─── Required: AI features (destination suggestions, itinerary, chat) ─────────
# Provider order (default): Agnes → Nova → OpenRouter → Gemini → Local. Set any one key to
# enable that provider; the rest act as automatic fallbacks. Override the primary
# with AI_PROVIDER and the chain with AI_PROVIDER_ORDER (comma-separated).

# ─── Agnes AI (default primary) ────────────────────────────────────────────────
# OpenAI-compatible API. Docs + keys: https://agnes-ai.com/doc/overview
AGNES_API_KEY=your_agnes_api_key_here
# Optional overrides:
# AGNES_MODEL=agnes-2.0-flash                 ← default chat model
# AGNES_MODELS=agnes-2.0-flash,other-model    ← comma-separated preference list
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ─── Amazon Nova (fallback) ────────────────────────────────────────────────────
# OpenAI-compatible Bearer gateway at https://api.nova.amazon.com/v1
NOVA_API_KEY=your_nova_api_key_here
# Optional overrides:
# NOVA_MODEL=nova-pro-v1                        ← default chat model
#   accessible: nova-premier-v1, nova-pro-v1, nova-lite-v1, nova-micro-v1, nova-2-lite-v1
# NOVA_MODELS=nova-pro-v1,nova-lite-v1          ← comma-separated preference list
# NOVA_BASE_URL=https://api.nova.amazon.com/v1

# ─── OpenRouter (fallback) ─────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys (takes < 1 minute, no credit card)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Optional: model override for OpenRouter ───────────────────────────────────
# Any model slug from https://openrouter.ai/models  (leave blank = free Llama 3.3 70B)
# Examples:
#   meta-llama/llama-3.3-70b-instruct:free   ← default (free tier)
#   anthropic/claude-3.5-sonnet              ← paid
#   openai/gpt-4o                            ← paid
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── Gemini (optional) ───────────────────────────────────────────────────────
# If you want to use Google Gemini, set either GEMINI_API_KEY (Google key) or
# GEMINI_API_URL to a Gemini-compatible endpoint and GEMINI_API_KEY for auth.
# Example (Google Generative API):
#   GEMINI_API_KEY=your_google_api_key_here
# Example (custom endpoint):
#   GEMINI_API_URL=https://your-gemini-proxy.example/v1/generate
# Optionally override the default Gemini model:
# GEMINI_MODEL=gemini-1

# ─── Local model (optional) ──────────────────────────────────────────────────
# If you run a local model server, set its URL here. The client will POST a
# JSON body { system, prompt, model, max_tokens } and expect a JSON response
# with a text-like field (text, output_text, choices, etc.). Default:
#   http://localhost:8000/generate
# LOCAL_MODEL_URL=http://localhost:8000/generate

# ─── Provider selection and fallback order (optional) ─────────────────────────
# AI_PROVIDER can be "openrouter", "gemini", or "local" to prefer a primary.
# AI_PROVIDER_ORDER (comma-separated) controls the order tried when falling back.
# Examples:
#   AI_PROVIDER=openrouter
#   AI_PROVIDER_ORDER=openrouter,gemini,local

# ─── Flight prices (optional) ────────────────────────────────────────────────
# Provider priority: Duffel → Kiwi → fast-flights scraper.
#
# Duffel official flight API (durable primary). Free sandbox token for testing;
# a production token (no card for test) returns live bookable content.
# Sign up at https://duffel.com to get an access token.
# DUFFEL_API_TOKEN=duffel_test_your_token_here
#
# Kiwi.com Tequila API — 100 free searches/month, no credit card required.
# Sign up at https://tequila.kiwi.com to get a key.
# If neither is set, falls back to Google Flights scraping via fast-flights (pip install -r requirements.txt).
# KIWI_API_KEY=your_kiwi_tequila_api_key_here

# ─── Hotel prices (optional) ─────────────────────────────────────────────────
# Amadeus Self-Service API — 2,000 calls/month free (test environment).
# Sign up at https://developers.amadeus.com to get client credentials.
# If not set, falls back to static accommodation estimates.
# AMADEUS_CLIENT_ID=your_amadeus_client_id_here
# AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
# AMADEUS_ENV=test  # or "production" for live bookable prices
